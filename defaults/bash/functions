dwn() {
  local TARGET="$PWD"
  local DL="$HOME/Downloads"

  [ -d "$DL" ] || { echo "Downloads directory not found."; return 1; }
  type -P gum >/dev/null || { echo "gum required."; return 1; }

  local ITEMS
  ITEMS=$(command ls -atp "$DL" | grep -Ev '^\.{1,2}/$')
  [ -z "$ITEMS" ] && { echo "Downloads is empty."; return 0; }

  local ITEM
  ITEM=$(printf '%s\n' "$ITEMS" | gum choose --height=50 --header="Downloads  →  $TARGET")
  [ -z "$ITEM" ] && return 0

  local ACTION
  ACTION=$(gum choose --header="$ITEM" "Move" "Copy" "Cancel")
  [ -z "$ACTION" ] || [ "$ACTION" = "Cancel" ] && return 0

  local FILE="${ITEM%/}"
  if [ "$ACTION" = "Move" ]; then
    mv -v "$DL/$FILE" "$TARGET/"
  else
    cp -rv "$DL/$FILE" "$TARGET/"
  fi
}

